<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dpd_fr_credential_configuration" model="ir.ui.view">
        <field name="name">DPD France Configuration</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="DPD France Configuration">
                    <group>
                        <field name="use_dpd_fr_shipping_provider"/>
                    </group>
                    <group invisible="use_dpd_fr_shipping_provider != True">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <strong>API URLs:</strong>
                            <br/>
                            Sandbox:
                            <code>https://e-station-testenv.cargonet.software/eprintwebservice/eprintwebservice.asmx</code>
                            <br/>
                            Production:
                            <code>https://e-station.cargonet.software/dpd-eprintwebservice/eprintwebservice.asmx</code>
                        </div>
                        <field name="dpd_fr_api_url" required="use_dpd_fr_shipping_provider != False"/>
                        <field name="dpd_fr_username" required="use_dpd_fr_shipping_provider != False"/>
                        <field name="dpd_fr_password" required="use_dpd_fr_shipping_provider != False"/>
                        <field name="dpd_fr_customer_number" required="use_dpd_fr_shipping_provider != False"/>
                        <field name="dpd_fr_center_number" required="use_dpd_fr_shipping_provider != False"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>