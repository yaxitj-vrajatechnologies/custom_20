<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_prompt_form" model="ir.ui.view">
        <field name="name">ai.prompt.form</field>
        <field name="model">ai.prompt</field>
        <field name="arch" type="xml">
            <form string="AI Prompt" create="0" delete="0">
                <header>
                    <button name="action_restore_defaults"
                            string="Restore Built-in Prompts"
                            type="object"
                            class="btn-secondary"
                            confirm="This will overwrite both prompts below with the prompts shipped with the module. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Prompt name"/>
                        </h1>
                    </div>
                    <p class="text-muted">
                   Edit the prompt according to your Sale Order creation requirements. This prompt is common to all Sale Order Automation records, so any changes made here will apply to all records.
                    </p>
                    <notebook>
                        <page string="Extraction Prompt" name="extraction_prompt">
                            <field name="extraction_instructions"
                                   nolabel="1"
                                   placeholder="Instructions sent to the AI when analyzing the document..."
                                   style="min-height: 500px;"/>
                        </page>
                        <page string="Creation Prompt" name="creation_prompt">
                            <field name="creation_instructions"
                                   nolabel="1"
                                   placeholder="Instructions sent to the AI when 'Create Sale Order' runs..."
                                   style="min-height: 500px;"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opens the single common prompt record straight in form view -->
    <record id="action_ai_prompt" model="ir.actions.server">
        <field name="name">AI Prompt</field>
        <field name="model_id" ref="model_ai_prompt"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_prompt()</field>
    </record>

    <menuitem id="menu_ai_prompt"
              name="AI Prompt"
              parent="menu_ai_sale_order_root"
              action="action_ai_prompt"
              sequence="90"/>

</odoo>
