<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cleaning_holiday_form_vts" model="ir.ui.view">
        <field name="name">cleaning.holiday.vts.form</field>
        <field name="model">cleaning.holiday.vts</field>
        <field name="arch" type="xml">
            <form string="Holiday">
                <sheet>
                    <group>
                        <group string="Holiday Info">
                            <field name="name"/>
                            <field name="holiday_type"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Configuration">
                            <field name="day_of_week"
                                   invisible="holiday_type != 'weekly_off'"/>
                            <field name="date_from"
                                   invisible="holiday_type != 'exception'"/>
                            <field name="date_to"
                                   invisible="holiday_type != 'exception'"/>
                        </group>
                    </group>
                    <group string="Additional Info">
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cleaning_holiday_list_vts" model="ir.ui.view">
        <field name="name">cleaning.holiday.vts.list</field>
        <field name="model">cleaning.holiday.vts</field>
        <field name="arch" type="xml">
            <list string="Holidays">
                <field name="name"/>
                <field name="holiday_type"/>
                <field name="day_of_week"
                       optional="show"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="action_menu_cleaning_holiday_vts" model="ir.actions.act_window">
        <field name="name">Holidays &amp; Week Off</field>
        <field name="res_model">cleaning.holiday.vts</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_is_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No holidays configured yet!
            </p>
            <p>
                Configure weekly off days and festival holidays
                to block bookings on those dates.
            </p>
        </field>
    </record>
    <menuitem
            id="menu_cleaning_holiday_vts"
            name="Holidays &amp; Week Off"
            parent="menu_cleaning_configuration_vts"
            action="action_menu_cleaning_holiday_vts"
            sequence="35"/>
</odoo>
