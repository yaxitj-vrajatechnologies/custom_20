<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_employee_form_inherit_tasks" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.tasks</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks">
                    <field name="task_count" widget="statinfo" string="Tasks"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Cleaning Shift" name="cleaning_shift">
                    <group string="Shift Assignment">
                        <field name="cleaning_shift_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>