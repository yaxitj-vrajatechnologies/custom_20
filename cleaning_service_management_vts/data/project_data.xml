<odoo>
    <data noupdate="1">

        <record id="project_cleaning_default_vts" model="project.project">
            <field name="name">Cleaning Management</field>
            <field name="label_tasks">Cleanings</field>
        </record>

        <record id="stage_cleaning_todo_vts" model="project.task.type">
            <field name="name">To Do</field>
            <field name="sequence">1</field>
            <field name="project_ids" eval="[(6, 0, [ref('project_cleaning_default_vts')])]"/>
        </record>

        <record id="stage_cleaning_progress_vts" model="project.task.type">
            <field name="name">In Progress</field>
            <field name="sequence">10</field>
            <field name="project_ids" eval="[(6, 0, [ref('project_cleaning_default_vts')])]"/>
        </record>

        <record id="stage_cleaning_done_vts" model="project.task.type">
            <field name="name">Done</field>
            <field name="sequence">20</field>
            <field name="project_ids" eval="[(6, 0, [ref('project_cleaning_default_vts')])]"/>
        </record>
    </data>
</odoo>