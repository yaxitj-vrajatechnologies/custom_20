<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_qbo_taxes_form" model="ir.ui.view">
        <field name="name">qbo.taxes.vts.form</field>
        <field name="model">qbo.taxes.vts</field>
        <field name="arch" type="xml">
            <form string="Quickbooks Taxes">
                <sheet>
                    <group>
                        <field name="quickbook_instance_id" readonly="1"/>
                        <field name="quickbook_tax_id" readonly="1"/>
                        <field name="quickbook_tax_name" readonly="1"/>
                        <field name="tax_id"/>
                        <field name="company_id"/>
                        <field name="qbo_response" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qbo_tax_map_filter" model="ir.ui.view">
        <field name="name">qbo.taxes.map.vts.search</field>
        <field name="model">qbo.taxes.vts</field>
        <field name="arch" type="xml">
            <search string="Search QuickBooks Taxes">

                <field name="tax_id"
                       string="Taxes"
                       filter_domain="['|', '|',
                           ('quickbook_tax_id', 'ilike', self),
                           ('quickbook_tax_name', 'ilike', self),
                           ('tax_id.name', 'ilike', self)
                       ]"
                />

            </search>
        </field>
    </record>
    <record id="view_qbo_tax_list" model="ir.ui.view">
        <field name="name">qbo.taxes.vts.list</field>
        <field name="model">qbo.taxes.vts</field>
        <field name="arch" type="xml">
            <list string="Quickbooks Taxes" editable="bottom">
                <field name="quickbook_instance_id" readonly="1"/>
                <field name="quickbook_tax_id" readonly="1"/>
                <field name="quickbook_tax_name" readonly="1"/>
                <field name="tax_id"/>
                <button name="taxes_mapping_view" type="object" string="View" class="btn btn-link"/>
            </list>
        </field>
    </record>
</odoo>
