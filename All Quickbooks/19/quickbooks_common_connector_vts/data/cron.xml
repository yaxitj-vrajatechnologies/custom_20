<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_refresh_qbo_token" model="ir.cron">
            <field name="name">Refresh QuickBooks Access Token</field>
            <field name="model_id" ref="quickbooks_common_connector_vts.model_quickbooks_connect"/>
            <field name="state">code</field>
            <field name="code">model.refresh_access_token()</field>
            <field name="interval_number">50</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="seq_account_code" model="ir.sequence">
            <field name="name">Quickbook Account Code</field>
            <field name="code">account.account</field>
            <field name="prefix">QB</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="send_invoice_bill_failed_mail" model="ir.cron">
            <field name="name">Send Mail For Export Failure</field>
            <field name="model_id" ref="quickbooks_common_connector_vts.model_quickbooks_connect"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">False</field>
            <field name="state">code</field>
            <field name="code">model._send_quickbooks_failure_email()</field>
        </record>

    </data>
</odoo>
