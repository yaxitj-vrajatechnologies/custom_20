<odoo>
    <record id="product_qk_inherit_form_view_vts" model="ir.ui.view">
        <field name="name">qk.product.form.view.inherit.vts</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="quickbook" string="Quickbooks">
                    <group>
                        <group>
                            <field name="qck_product_type" readonly="1"/>
                            <field name="quickbook_vendor_product" readonly="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
