<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ai_provider_config_default" model="ai.provider.config">
        </record>

        <record id="view_ai_provider_config_form" model="ir.ui.view">
            <field name="name">ai.provider.config.form</field>
            <field name="model">ai.provider.config</field>
            <field name="arch" type="xml">
                <form create="False">
                    <sheet>
                        <div class="oe_title">
                            <h1>AI Provider Settings</h1>
                            <p class="text-muted">
                                Choose which AI provider is used to generate
                                Email Marketing templates.
                            </p>
                        </div>
                        <group>
                            <field name="ai_provider" widget="radio"/>
                        </group>
                        <group invisible="ai_provider != 'openai'">
                            <field name="openai_api_key" password="True" required="ai_provider == 'openai'"/>
                            <field name="openai_model" required="ai_provider == 'openai'"/>
                        </group>

                        <group invisible="ai_provider != 'anthropic'">
                            <field name="anthropic_api_key" required="ai_provider == 'anthropic'" password="True"/>
                            <field name="anthropic_model" required="ai_provider == 'anthropic'"/>
                            <field name="claude_max_tokens"/>
                        </group>


                        <group invisible="ai_provider != 'gemini'">
                            <field name="gemini_api_key" required="ai_provider == 'gemini'" password="True"/>
                            <field name="gemini_model" required="ai_provider == 'gemini'"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>
    </data>
    <record id="action_ai_provider_config" model="ir.actions.act_window">
        <field name="name">Ai Provider</field>
        <field name="res_model">ai.provider.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ai_provider_config_form"/>
        <field name="res_id" ref="ai_provider_config_default"/>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_ai_provider_config"
              name="AI Provider"
              parent="ai_email_template_generator.ai_configuration_menu"
              action="action_ai_provider_config"
              sequence="10"/>
</odoo>