<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_advance_payment_wizard_form" model="ir.ui.view">
        <field name="name">view.advance.payment.wizard.form</field>
        <field name="model">create.advance.payment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="group1">
                            <field name="journal_id" options="{'no_open': True, 'no_create': True}"
                                   domain="[('type', 'in', ('bank', 'cash'))]"/>
                            <field name="payment_method_line_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="partner_bank_id" invisible="1"/>
                            <field name="payment_token_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="available_payment_method_line_ids" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="communication"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Create Payment" name="action_create_payment" type="object" class="oe_highlight"/>
                    <button string="Discard" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_advance_payment_wizard" model="ir.actions.act_window">
        <field name="name">Create Advance Payment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">create.advance.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
