<odoo>
    <data>
        <record id="view_repair_order_wizard" model="ir.ui.view">
            <field name="name">repair.order.wizard.form</field>
            <field name="model">repair.order.wizard</field>
            <field name="arch" type="xml">
                <form string="Repair Order Wizard">
                    <sheet>
                        <group>
                            <field name="order_line_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Submit" type="object" name="create_repair_orders" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>