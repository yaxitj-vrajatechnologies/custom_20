<odoo>
    <data noupdate="1">
        <!-- Scheduled Action for sending rental return reminders -->
        <record id="rental_return_reminder_cron" model="ir.cron">
            <field name="name">Send Rental Return Reminders</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.send_rental_return_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
