<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_inventory_stock_ai_analysis" model="ir.cron">
            <field name="name">Inventory AI Agent: Auto Generate Stock File</field>
            <field name="model_id" ref="inventory_ai_agent_vts.model_vraja_ai_card"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.with_context(from_cron=True).action_cron_low_stock_ai_generate_excel()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="ir_cron_run_inventory_stock_ai_analysis" model="ir.cron">
            <field name="name">Inventory AI Agent - Auto Run AI Analysis</field>
            <field name="model_id" ref="inventory_ai_agent_vts.model_vraja_ai_card"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.with_context(from_cron=True).action_cron_inventory_ai_analysis()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
