<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_price_quotation_form" model="ir.ui.view">
        <field name="name">price.quotation.form</field>
        <field name="model">price.quotation</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="vendor_id" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="enquiry_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="rfq_sent_date" readonly="1"/>
                            <field name="valid_until" readonly="state == 'received'"/>
                        </group>
                    </group>
                    <group string="RFQ Sheet Sent to Vendor">
                        <field name="rfq_attachment" filename="rfq_attachment_name" readonly="1"/>
                        <field name="rfq_attachment_name" invisible="1"/>
                    </group>
                    <group string="Vendor Filled Sheet (Price + Lead Time)">
                        <field name="import_file" filename="import_filename"
                               options="{'accepted_file_extensions': '.csv'}"
                               readonly="state == 'received'"/>
                        <field name="import_filename" invisible="1"/>
                    </group>
                    <field name="line_ids" readonly="state == 'received'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty_offered"/>
                            <field name="unit_price"/>
                            <field name="has_lead_time" column_invisible="1"/>
                            <field name="lead_time" invisible="not has_lead_time"/>
                            <field name="expected_delivery_date" string="Lead Date" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_price_quotation_list" model="ir.ui.view">
        <field name="name">price.quotation.list</field>
        <field name="model">price.quotation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'"
                  decoration-info="state == 'sent'"
                  decoration-success="state == 'received'">
                <field name="enquiry_id"/>
                <field name="vendor_id"/>
                <field name="rfq_sent_date"/>
                <field name="valid_until"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'sent'"
                       decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_price_quotation_line_list" model="ir.ui.view">
        <field name="name">price.quotation.line.list</field>
        <field name="model">price.quotation.line</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  decoration-success="is_lowest_price"
                  decoration-info="is_lowest_leadtime and not is_lowest_price">
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="qty_offered"/>
                <field name="unit_price"/>
                <field name="has_lead_time" column_invisible="1"/>
                <field name="lead_time" invisible="not has_lead_time"/>
                <field name="expected_delivery_date" string="Lead Date" readonly="1" optional="show"/>
                <field name="product_weight" optional="hide"/>
                <field name="is_lowest_price" readonly="1" widget="boolean_toggle"/>
                <field name="is_lowest_leadtime" readonly="1" widget="boolean_toggle"/>
                <field name="enquiry_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_price_quotation" model="ir.actions.act_window">
        <field name="name">Vendor Quotations</field>
        <field name="res_model">price.quotation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
