<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_prompt_form_view" model="ir.ui.view">
        <field name="name">ai.prompt.vts.form</field>
        <field name="model">ai.prompt.vts</field>
        <field name="arch" type="xml">
            <form string="AI Prompt" create="0" delete="0">
                <header>
                    <button name="action_restore_defaults"
                            string="Restore Built-in Prompt"
                            type="object"
                            class="btn-secondary"
                            confirm="This will overwrite the prompt below with the prompt shipped with the module. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Prompt name"/>
                        </h1>
                    </div>
                    <p class="text-muted">
                        This prompt is common to all Vendor Pricelist AI Update records. New records start with a copy
                        of it, so changes made here apply to records created afterwards.
                    </p>
                    <field name="ai_prompt"
                           nolabel="1"
                           placeholder="Instructions sent to the AI when analyzing the vendor price file..."
                           style="min-height: 500px;"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opens the single common prompt record straight in form view (no list view) -->
    <record id="action_ai_prompt_vts_open" model="ir.actions.server">
        <field name="name">AI Prompt</field>
        <field name="model_id" ref="model_ai_prompt_vts"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_ai_prompt()</field>
    </record>

    <menuitem id="menu_ai_prompt_vts"
              name="AI Prompt"
              parent="menu_vendor_pricelist_root"
              action="action_ai_prompt_vts_open"
              sequence="110"/>

</odoo>