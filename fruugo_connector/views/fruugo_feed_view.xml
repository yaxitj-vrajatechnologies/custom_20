<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FRUUGO FEED — List View
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_fruugo_feed_list" model="ir.ui.view">
        <field name="name">fruugo.feed.list</field>
        <field name="model">fruugo.feed</field>
        <field name="arch" type="xml">
            <list string="Fruugo Feeds" decoration-muted="state == 'paused'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'draft'"
                    decoration-danger="state == 'paused'"/>
                <field name="last_generated"/>
                <field name="last_status" widget="badge"
                    decoration-success="last_status == 'success'"
                    decoration-danger="last_status == 'error'"/>
                <field name="log_count" string="Logs"/>
                <field name="language_id" optional="show"/>
                <field name="currency_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FRUUGO FEED — Form View
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_fruugo_feed_form" model="ir.ui.view">
        <field name="name">fruugo.feed.form</field>
        <field name="model">fruugo.feed</field>
        <field name="arch" type="xml">
            <form string="Fruugo Feed">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                        class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_pause" string="Pause" type="object"
                        invisible="state != 'active'"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object"
                        invisible="state == 'draft'"/>
                    <button name="action_generate_now" string="⚡ Generate Feed Now" type="object"
                        class="btn-primary" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object"
                            class="oe_stat_button" icon="list_alt">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Feed Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. My Shop — Fruugo UK Feed"/>
                        </h1>
                    </div>

                    <!-- ── Feed URL Banner ───────────────────────────────────── -->
                    <div class="alert alert-info" role="alert" invisible="not feed_token or state == 'draft'">
                        <div class="d-flex align-items-center gap-2">
                           <i class="oi text-info fs-4" data-icon="link"/>
                            <div>
                                <strong>Your Fruugo Feed URL (give this to Fruugo, one-time setup):</strong>
                                <div class="mt-1 d-flex flex-row align-items-center gap-2">
                                    <field name="feed_url" readonly="1"
                                        widget="url" class="fw-bold text-break mb-0"/>
                                    <field name="feed_url" widget="CopyClipboardButton" nolabel="1" string="Copy" options="{'btn_class': 'btn-outline-secondary btn-sm'}"/>
                                </div>
                                <small class="text-muted">
                                    This URL is permanent. Fruugo polls it automatically. File name in the feed: <code>fruugo_feed.xml</code>
                                </small>
                                <div class="mt-2">
                                    <small class="text-info">
                                      <i class="oi" data-icon="info"/> <strong>Note:</strong>
                                        Clicking this link will always serve the <strong>latest generated XML feed</strong>.
                                        To ensure the most up-to-date data (products, prices, stock), click
                                        <strong>⚡ Generate Feed Now</strong> before sharing or testing the URL.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Draft Banner ─────────────────────────────────────── -->
                    <div class="alert alert-warning" role="alert" invisible="state != 'draft'">
                        <i class="oi" data-icon="warning"/> Configure the feed below, then click <strong>Activate</strong> to enable it and generate the public URL.
                    </div>

                    <group>
                        <!-- Left column -->
                        <group string="Store &amp; Identity">
                            <field name="store_url" placeholder="https://yourshop.com"/>
                            <field name="feed_token" readonly="1"/>
                            <field name="language_id"/>
                            <field name="currency_id"/>
                            <field name="pricelist_id"/>
                        </group>

                        <!-- Right column -->
                        <group string="Pricing &amp; VAT">
                            <field name="price_include_vat"/>
                            <field name="default_vat_rate" widget="percentage"
                                help="Default VAT % when no tax is configured on the product. EU: 20, Non-EU: 0"/>
                        </group>
                    </group>

                    <group string="Product Filter &amp; Stock">
                        <group>
                            <field name="include_variants"/>
                            <field name="max_products"/>
                            <field name="product_domain"
                                   widget="domain"
                                options="{'model': 'product.template'}"
                                help="Odoo domain to filter products. Leave blank for all saleable products."/>
                        </group>
                        <group>
                            <field name="stock_location_ids" widget="many2many_tags"
                                placeholder="Leave empty = all locations"/>
                        </group>
                    </group>

                    <group invisible="state == 'draft'">
                        <group string="Sync Status">
                            <field name="last_generated"/>
                            <field name="last_status" widget="badge"
                                decoration-success="last_status == 'success'"
                                decoration-danger="last_status == 'error'"/>
                        </group>
                        <group string="Log Retention">
                            <field name="log_cleanup_enabled" widget="boolean_toggle"/>
                            <field name="log_retention_days"
                                invisible="not log_cleanup_enabled"
                                placeholder="30"
                                help="Number of days to keep generation logs. Older logs and their XML attachments will be removed automatically."/>
                        </group>
                    </group>

                    <!-- Cleanup button — aligned under right (Log Retention) column -->
                    <div class="row mb-3" invisible="state == 'draft' or not log_cleanup_enabled">
                        <div class="col-lg-6"/>
                        <div class="col-lg-6">
                            <button name="action_cleanup_old_logs" type="object"
                                class="btn btn-sm btn-outline-danger">
                               <i class="oi" data-icon="delete"/> Cleanup Old Logs Now
                            </button>
                            <small class="text-muted ms-2">
                                <i class="oi" data-icon="info"/> Removes old logs and their XML attachments.
                            </small>
                        </div>
                    </div>

                    <notebook>
                        <!-- ── Logs Tab ─────────────────────────────────────── -->
                        <page string="Generation Logs" name="logs">
                            <field name="log_ids" readonly="1" nolabel="1">
                                <list string="Logs" decoration-danger="status == 'error'" decoration-success="status == 'success'">
                                    <field name="create_date" string="Date/Time"/>
                                    <field name="trigger"/>
                                    <field name="status" widget="badge"
                                        decoration-success="status == 'success'"
                                        decoration-danger="status == 'error'"/>
                                    <field name="product_count" string="Products"/>
                                    <field name="file_size_kb" string="Size (KB)" digits="[10,2]"/>
                                    <field name="duration_seconds" string="Duration (s)" digits="[10,2]"/>
                                    <field name="attachment_id" string="XML File" widget="many2one"/>
                                    <field name="message" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Instructions Tab ────────────────────────────── -->
                        <page string="How to Set Up" name="instructions">
                            <div class="p-3">
                               <h4><i class="oi text-primary" data-icon="rocket_launch"/> Quick Setup Guide</h4>
                                <ol>
                                    <li class="mb-2">
                                        <strong>Step 1 — Activate this feed</strong><br/>
                                        Click the <em>Activate</em> button above. This generates your unique Feed URL.
                                    </li>
                                    <li class="mb-2">
                                        <strong>Step 2 — Set product Fruugo Category</strong><br/>
                                        Go to each product → Fruugo tab → fill in <em>Fruugo Category</em>
                                        (e.g. <code>Clothing &gt; Men's Clothing &gt; Tops</code>).
                                    </li>
                                    <li class="mb-2">
                                        <strong>Step 3 — Generate the feed</strong><br/>
                                        Click <em>Generate Feed Now</em> to create the first XML file. A log entry with the XML attached will appear in the Logs tab.
                                    </li>
                                    <li class="mb-2">
                                        <strong>Step 4 — Give the URL to Fruugo</strong><br/>
                                        Copy the <em>Feed URL</em> shown in the blue banner above. Paste it into your Fruugo Retailer Portal → Integration → Feed URL field. You only do this once.
                                    </li>
                                    <li class="mb-2">
                                        <strong>Step 5 — Cron runs automatically</strong><br/>
                                        A scheduled job runs daily at 02:00 UTC, regenerates the XML, and creates a new log entry. Fruugo polls the same URL every time.
                                    </li>
                                </ol>
                                <div class="alert alert-success" role="status">
                                 <i class="oi" data-icon="check_circle"/> <strong>File name is always <code>fruugo_feed.xml</code></strong> — the URL never changes unless you regenerate the token.
                                </div>
                                <hr/>
                                <h5>Need to change the URL? (Advanced)</h5>
                                <p class="text-muted">
                                    Only regenerate the token if the URL has been compromised.
                                    After regenerating, you must update the URL in Fruugo's Retailer Portal again.
                                </p>
                                <button name="action_regenerate_token" type="object"
                                    class="btn btn-sm btn-warning">
                                   <i class="oi" data-icon="refresh"/> Regenerate Feed Token (changes URL)
                                </button>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FRUUGO FEED — Kanban View
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_fruugo_feed_kanban" model="ir.ui.view">
        <field name="name">fruugo.feed.kanban</field>
        <field name="model">fruugo.feed</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="last_generated"/>
                <field name="last_status"/>
                <field name="log_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value}"/>
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                    options="{'classes': {'active': 'success', 'draft': 'warning', 'paused': 'danger'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.last_generated.raw_value">
                                <i class="oi" data-icon="schedule"/> Last: <field name="last_generated"/>
                                </div>
                                <div t-if="record.last_status.raw_value">
                                    Status: <field name="last_status" widget="badge"
                                        decoration-success="last_status == 'success'"
                                        decoration-danger="last_status == 'error'"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                   <i class="oi" data-icon="list_alt"/> <field name="log_count"/> logs
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FRUUGO FEED — Action
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_fruugo_feed" model="ir.actions.act_window">
        <field name="name">Fruugo Feeds</field>
        <field name="res_model">fruugo.feed</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Fruugo product feed!
            </p>
            <p>
                Configure a feed to automatically generate and serve your product XML to Fruugo.
            </p>
        </field>
    </record>

</odoo>