<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <div
                    class="app_settings_block"
                    data-string="MCP Server"
                    string="MCP Server"
                    data-key="mcp_server"
                >
                    <h2>MCP Server Configuration</h2>
                    <div class="row mt16 o_settings_container" id="mcp_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_enabled" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_enabled" />
                                <a
                                    title="Turns the MCP server on or off. When it is off, the /mcp endpoint, the REST routes and the XML-RPC proxy refuse all requests. Only members of the MCP User group can connect."
                                    class="o_doc_link me-2"
                                >
                                    <i class="oi" data-icon="help" />
                                </a>
                                <div class="text-muted">
                                    Enable or disable MCP server access globally
                                </div>
                                <br />
                                <div class="content-group" invisible="not mcp_enabled">
                                    <div>
                                        <button
                                            name="%(mcp_server.action_mcp_enabled_models)d"
                                            icon="east"
                                            type="action"
                                            string="Manage MCP Available Models"
                                            class="btn-link"
                                        />
                                    </div>
                                    <div class="mt8">
                                        <button
                                            name="%(mcp_server.action_mcp_custom_tool)d"
                                            icon="east"
                                            type="action"
                                            string="Manage Custom Tools"
                                            class="btn-link"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div
                        class="row mt16 o_settings_container"
                        invisible="not mcp_enabled"
                    >
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_enable_oauth" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_enable_oauth" />
                                <a
                                    title="Lets browser MCP clients, such as Claude.ai and Gemini, connect after the user logs in to Odoo. API keys work in both cases. When this is off, the /mcp/oauth/* routes and OAuth discovery answer HTTP 404. On by default."
                                    class="o_doc_link me-2"
                                >
                                    <i class="oi" data-icon="help" />
                                </a>
                                <div class="text-muted">
                                    Let browser clients sign in with Odoo via OAuth 2.1 (on by default)
                                </div>
                                <div
                                    class="content-group mt16"
                                    invisible="not mcp_enable_oauth"
                                >
                                    <div>
                                        <button
                                            name="%(mcp_server.action_mcp_oauth_clients)d"
                                            icon="east"
                                            type="action"
                                            string="Manage OAuth Clients"
                                            class="btn-link"
                                        />
                                    </div>
                                    <div class="mt8">
                                        <button
                                            name="%(mcp_server.action_mcp_oauth_tokens)d"
                                            icon="east"
                                            type="action"
                                            string="Manage OAuth Tokens"
                                            class="btn-link"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_enable_logging" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_enable_logging" />
                                <a
                                    title="Writes one audit row per MCP call to the MCP log: user, IP address, tool, model, record IDs, duration and errors. The rows store argument names and result sizes, never field values. When this is off, nothing is logged, failed logins included."
                                    class="o_doc_link me-2"
                                >
                                    <i class="oi" data-icon="help" />
                                </a>
                                <div class="text-muted">
                                    Keep an audit log of MCP calls (metadata only)
                                </div>

                                <div
                                    class="content-group mt16"
                                    invisible="not mcp_enable_logging"
                                >
                                    <div class="row">
                                        <div class="col-12">
                                            <label
                                                for="mcp_log_retention_days"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="Number of days to keep MCP log rows. A daily scheduled action deletes older rows. Set 0 to keep all rows. Default: 30."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Older log rows are deleted every day
                                            </div>
                                            <field
                                                name="mcp_log_retention_days"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> days
                                        </div>
                                    </div>
                                    <div class="row mt16">
                                        <div class="col-12">
                                            <button
                                                name="%(mcp_server.action_mcp_logs)d"
                                                icon="east"
                                                type="action"
                                                string="View MCP Logs"
                                                class="btn-link"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div
                        class="row mt16 o_settings_container"
                        invisible="not mcp_enabled"
                    >
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <label for="mcp_allowed_origins" />
                                <a
                                    title="Comma-separated browser origins that can call /mcp, for example https://app.example.com. When the list is empty, all origins are accepted. When it is set, a request from another origin gets HTTP 403. Native clients, such as Claude Desktop and Cursor, send no Origin header and are always accepted."
                                    class="o_doc_link me-2"
                                >
                                    <i class="oi" data-icon="help" />
                                </a>
                                <div class="text-muted">
                                    Restrict browser calls to these Origins (empty = no restriction)
                                </div>
                                <div class="content-group mt16">
                                    <field
                                        name="mcp_allowed_origins"
                                        placeholder="https://app.example.com, https://tool.example.org"
                                        class="o_light_label"
                                    />
                                </div>
                                <div class="mt16">
                                    <label for="mcp_link_ttl_hours" />
                                    <a
                                        title="Hours that a read_attachment download link stays valid. Anyone with the link can download the file without an Odoo login, and a single link cannot be revoked. Keep it short. The AI client asks for a new link when one expires. Maximum: 1008 hours (42 days). Set 0 to use the default. Default: 1."
                                        class="o_doc_link me-2"
                                    >
                                        <i class="oi" data-icon="help" />
                                    </a>
                                    <div class="text-muted">
                                        Validity of read_attachment download links (no login needed)
                                    </div>
                                    <div class="content-group mt16">
                                        <field
                                            name="mcp_link_ttl_hours"
                                            class="o_light_label oe_inline"
                                            style="width: 100px;"
                                        /> hours
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_enable_rate_limiting" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_enable_rate_limiting" />
                                <a
                                    title="Limits the requests per minute of each user on /mcp, the REST routes and the XML-RPC proxy. Each Odoo worker counts on its own, so with several workers a user can make up to (workers x limit) requests. For a strict limit, use a reverse proxy. Off by default."
                                    class="o_doc_link me-2"
                                >
                                    <i class="oi" data-icon="help" />
                                </a>
                                <div class="text-muted">
                                    Enforce request limits to prevent API abuse
                                </div>

                                <div
                                    class="content-group mt16"
                                    invisible="not mcp_enable_rate_limiting"
                                >
                                    <div class="row">
                                        <div class="col-12">
                                            <label
                                                for="mcp_request_limit"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="Requests per user per minute. Past this number, the server answers HTTP 429 until the minute ends. Pings do not count. Values from 1 to 9 count as 10. Set 0 for no limit. Default: 300."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Maximum requests per minute per user (0 = unlimited)
                                            </div>
                                            <field
                                                name="mcp_request_limit"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> requests/minute
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div
                        class="row mt16 o_settings_container"
                        id="mcp_tool_limits"
                        invisible="not mcp_enabled"
                    >
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Tool Limits</span>
                                <div class="text-muted">
                                    Default and maximum sizes applied to MCP read and batch write tools
                                </div>
                                <div class="content-group mt16">
                                    <div class="row">
                                        <div class="col-12">
                                            <label
                                                for="mcp_default_limit"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="Number of records that search_records, aggregate_records and list_record_attachments return when the client sends no limit. Default: 25."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Records returned when the client does not request a limit
                                            </div>
                                            <field
                                                name="mcp_default_limit"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> records
                                        </div>
                                    </div>
                                    <div class="row mt16">
                                        <div class="col-12">
                                            <label
                                                for="mcp_max_limit"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="Largest number of records that search_records, aggregate_records and list_record_attachments return in one call. A larger limit from the client is reduced to this value. Default: 100."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Hard cap on records returned per request
                                            </div>
                                            <field
                                                name="mcp_max_limit"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> records
                                        </div>
                                    </div>
                                    <div class="row mt16">
                                        <div class="col-12">
                                            <label
                                                for="mcp_max_batch_size"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="Largest number of entries in one create_records or update_records call. The server refuses a larger batch and asks the client to split it. Default: 100."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Maximum entries per batch write call (create_records / update_records)
                                            </div>
                                            <field
                                                name="mcp_max_batch_size"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> entries
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Output Formatting</span>
                                <div class="text-muted">
                                    Which fields and related records appear in tool output
                                </div>
                                <div class="content-group mt16">
                                    <div class="row">
                                        <div class="col-12">
                                            <label
                                                for="mcp_max_smart_fields"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="When the client lists no fields, the server picks the most useful fields, up to this number. This keeps the answers short for the AI model. Default: 15."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Maximum fields auto-selected when no fields are listed
                                            </div>
                                            <field
                                                name="mcp_max_smart_fields"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> fields
                                        </div>
                                    </div>
                                    <div class="row mt16">
                                        <div class="col-12">
                                            <label
                                                for="mcp_max_related_items"
                                                class="o_light_label"
                                            />
                                            <a
                                                title="get_record lists up to this many linked records by name. A larger one-to-many or many-to-many field shows a count and a search hint instead. Set 0 to always show the count. Default: 3."
                                                class="o_doc_link me-2"
                                            >
                                                <i class="oi" data-icon="help" />
                                            </a>
                                            <div class="text-muted">
                                                Related records shown inline before collapsing to a count
                                            </div>
                                            <field
                                                name="mcp_max_related_items"
                                                class="o_light_label oe_inline"
                                                style="width: 100px;"
                                            /> items
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
