<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══ Search View (AI Logs) Inherit ═══════════════════════════════════ -->
    <record id="view_vraja_ai_log_search_inherit_cashflow" model="ir.ui.view">
        <field name="name">vraja.ai.log.search.inherit.cashflow</field>
        <field name="model">vraja.ai.log</field>
        <field name="inherit_id" ref="vraja_ai.vraja_common_ai_log_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Cashflow Logs" name="store_cashflow"
                        domain="[('vraja_common_log_store', '=', 'cashflow')]"/>
                <group>
                    <filter string="Store" name="group_store"
                            context="{'group_by': 'vraja_common_log_store'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ═══ Cashflow AI Log — Inherited Form View ═══════════════════════════
         Injects cashflow-specific content into the <div id="vraja_ai_log_content"/>
         placeholder provided by the base vraja_ai module.
         All sections are wrapped with invisible="vraja_common_log_store != 'cashflow'"
         so they are completely hidden when viewing logs from other stores.
    ════════════════════════════════════════════════════════════════════════ -->
    <record id="view_vraja_cashflow_ai_log_form" model="ir.ui.view">
        <field name="name">vraja.ai.log.cashflow.form</field>
        <field name="model">vraja.ai.log</field>
        <field name="inherit_id" ref="vraja_ai.vraja_ai_log_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <!-- Wrapper: everything inside is only visible for cashflow logs -->
                <div invisible="vraja_common_log_store != 'cashflow'">

                    <!-- ── Status Bar ──────────────────────────────────────── -->
                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="success,failed"/>
                    </header>

                    <sheet>

                        <!-- ── Title Row ───────────────────────────────────── -->
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                            <h2><field name="vraja_common_log_store" readonly="1"/></h2>
                        </div>

                        <!-- ── Run Information ─────────────────────────────── -->
                        <group string="Run Information">
                            <group>
                                <field name="run_date" readonly="1"/>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'success'"
                                       decoration-danger="status == 'failed'"
                                       readonly="1"/>
                                <field name="ai_provider" readonly="1"/>
                                <field name="ai_llm_model" readonly="1"/>
                            </group>
                            <group>
                                <field name="cashflow_analysis_id" readonly="1"/>
                                <field name="date_from" readonly="1"/>
                                <field name="date_to" readonly="1"/>
                            </group>
                        </group>

                        <!-- ── Financial Snapshot ──────────────────────────── -->
                        <group string="Financial Snapshot at Run Time">
                            <group string="Cash Position">
                                <field name="bank_balance" widget="monetary" readonly="1"/>
                                <field name="cash_runway_days" readonly="1"/>
                                <field name="zero_cash_date" readonly="1"/>
                                <field name="runway_message" readonly="1"/>
                            </group>
                            <group string="Liquidity Assessment">
                                <field name="liquidity_status" readonly="1"/>
                                <field name="liquidity_score" readonly="1"/>
                            </group>
                        </group>

                        <!-- ── LLM Token Usage ─────────────────────────────── -->
                        <group string="LLM Token Usage">
                            <group>
                                <field name="prompt_tokens" readonly="1"/>
                                <field name="completion_tokens" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_tokens" readonly="1"/>
                            </group>
                        </group>

                        <!-- ── Outcome ─────────────────────────────────────── -->
                        <notebook>
                            <page string="Executive Summary">
                                <field name="executive_summary"
                                       widget="text" nolabel="1" readonly="1"/>
                            </page>
                            <page string="Error Details"
                                  invisible="status != 'failed'">
                                <field name="error_message"
                                       widget="text" nolabel="1" readonly="1"/>
                            </page>
                        </notebook>

                    </sheet>
                </div>

            </xpath>

        </field>
    </record>

</odoo>