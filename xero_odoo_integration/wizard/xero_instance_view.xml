<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_xero_instance_wizard_form" model="ir.ui.view">
            <field name="name">xero.instance.wizard.form</field>
            <field name="model">xero.instance.wizard</field>
            <field name="arch" type="xml">
            <form string="Select Xero Instance">
                <group>
                    <field name="xero_instance_id"/>
                </group>
                <footer>
                    <button name="xero_export_operation"
                        type="object"
                        string="Export"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
            </field>
        </record>
    </data>
</odoo>