<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="xero_acc_move_inherit_form_view_vts" model="ir.ui.view">
        <field name="name">xero.purchase.order.form.inherit.vts</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="Xero_purchase_order" string="Xero Details">
                    <group>
                        <group>
                            <field name="xero_instance_id" readonly="1"/>
                            <field name="xero_po_id" readonly="1"/>
                            <field name="xero_po_number" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>