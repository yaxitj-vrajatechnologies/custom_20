<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   <record id="view_xero_partner_map_list" model="ir.ui.view">
        <field name="name">xero.partner.map.list</field>
        <field name="model">xero.partner.map</field>
        <field name="arch" type="xml">
            <list string="Xero Partner Mapping" editable="bottom">
                <field name="xero_instance_id"/>
                <field name="xero_contact_id"/>
                <field name="xero_contact_name"/>
                <field name="partner_id"/>
                <button name="action_customer_mapping" string="View" type="object" class="oe_link"/>
            </list>
        </field>
    </record>

    <record id="view_xero_partner_map_form" model="ir.ui.view">
        <field name="name">xero.partner.map.form</field>
        <field name="model">xero.partner.map</field>
        <field name="arch" type="xml">
            <form string="Xero Partner Mapping">
                <sheet>
                    <group>
                        <field name="xero_instance_id" readonly="1"/>
                        <field name="xero_contact_id" readonly="1"/>
                        <field name="xero_contact_name" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="xero_response" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xero_partner_map_filter" model="ir.ui.view">
        <field name="name">xero.partner.map.search</field>
        <field name="model">xero.partner.map</field>
        <field name="arch" type="xml">
            <search string="Search Xero Partner Map">
                <field name="partner_id"
                       string="Customer"
                       filter_domain="['|','|',('xero_contact_id','ilike', self),('xero_contact_name', 'ilike', self),('partner_id.name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_xero_partner_mapping" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">xero.partner.map</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
