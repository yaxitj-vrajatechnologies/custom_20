<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   <record id="view_xero_contact_group_list" model="ir.ui.view">
        <field name="name">xero.contact.group.map.list</field>
        <field name="model">xero.contact.group.map</field>
        <field name="arch" type="xml">
            <list string="Xero Product Mapping" editable="bottom">
                <field name="xero_instance_id"/>
                <field name="xero_group_id"/>
                <field name="xero_group_name"/>
                <field name="category_id"/>
                <button name="action_contact_group_mapping"
                    string="View"
                    type="object"
                    class="oe_link"/>
            </list>
        </field>
    </record>

    <record id="view_xero_contact_group_map_form" model="ir.ui.view">
        <field name="name">xero.contact.group.map.form</field>
        <field name="model">xero.contact.group.map</field>
        <field name="arch" type="xml">
            <form string="Xero Product Mapping">
                <sheet>
                    <group>
                        <field name="xero_instance_id" readonly="1"/>
                        <field name="xero_group_id" readonly="1"/>
                        <field name="xero_group_name" readonly="1"/>
                        <field name="category_id"/>
                        <field name="xero_response" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xero_contact_group_map_filter" model="ir.ui.view">
        <field name="name">xero.contact.group.map.search</field>
        <field name="model">xero.contact.group.map</field>
        <field name="arch" type="xml">
            <search string="Search Xero Contact Group">
                <field name="xero_group_name"
                   string="Contact Group"
                   filter_domain="['|','|',('xero_group_id','ilike', self),('xero_group_name','ilike', self),('category_id.name','ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_xero_contact_group_mapping" model="ir.actions.act_window">
        <field name="name">Contact Group</field>
        <field name="res_model">xero.contact.group.map</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
