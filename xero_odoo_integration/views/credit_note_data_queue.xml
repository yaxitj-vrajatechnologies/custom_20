<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="xero_creditnote_queue_tree_view" model="ir.ui.view">
        <field name="name">Xero Credit Note Queue</field>
        <field name="model">creditnote.data.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="create_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'partially_completed'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>
    <record id="xero_creditnote_queue_form_view" model="ir.ui.view">
        <field name="name">Xero Credit Note Queue</field>
        <field name="model">creditnote.data.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="process_xero_creditnote_queue"
                            type="object"
                            string="Process Queue Manually"
                            class="btn-primary"
                            invisible="state == 'completed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-info text-left" role="alert">
                    <ul>
                        <li>
                            To process the queue click on the Process Queue Manually button.
                        </li>
                        <li>
                            If a queue line failed for any reason and by making required
                            changes
                            in Odoo it can process it successfully, so you can try this option to click process
                            manually.
                        </li>
                        <li>
                            This will not fetch any data from the Xero store to reprocess it.
                        </li>
                        <li>
                            This process might take some time to complete.
                        </li>
                    </ul>
                </div>
                <sheet>
                    <div>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="create_date" string="Imported at"/>
                        </group>
                        <group>
                            <field name="xero_log_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Credit Note Lines" name="creditnote_queue_detail_line">
                            <field name="creditnote_queue_line_ids" readonly="1">
                                <list decoration-danger="state == 'failed'"
                                      decoration-success="state == 'completed'">
                                    <field name="name"/>
                                    <field name="creditnote_data_id"/>
                                    <field name="xero_move_type"/>
                                    <field name="state"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="queue_id"/>
                                                <field name="xero_move_type"/>
                                                <field name="instance_id" readonly="1"/>
                                                <field name="state" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="creditnote_data_id"/>
                                                <field name="number_of_fails"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Response Data" name="response">
                                                <field name="creditnote_data_to_process" widget="ace"
                                                />
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_xero_creditnote_queue" model="ir.actions.act_window">
        <field name="name">Xero Credit Note Queue</field>
        <field name="res_model">creditnote.data.queue</field>
        <field name="view_id" ref="xero_creditnote_queue_tree_view"/>
    </record>

    <record id="seq_xero_creditnote_queue" model="ir.sequence">
        <field name="name">Xero Credit Note Queue Seq</field>
        <field name="code">creditnote.data.queue</field>
        <field name="padding">5</field>
        <field name="prefix">CreditNote/Queue/</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>