<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   <record id="view_xero_tax_map_list" model="ir.ui.view">
        <field name="name">xero.tax.map.list</field>
        <field name="model">xero.tax.map</field>
        <field name="arch" type="xml">
            <list string="Xero Tax Mapping" editable="bottom">
                <field name="xero_instance_id"/>
                <field name="xero_tax_id"/>
                <field name="xero_tax_name"/>
                <field name="tax_id" widget="many2many_tags"/>
                <button name="action_tax_mapping"
                    string="View"
                    type="object"
                    class="oe_link"/>
            </list>
        </field>
    </record>

    <record id="view_xero_tax_map_form" model="ir.ui.view">
        <field name="name">xero.tax.map.form</field>
        <field name="model">xero.tax.map</field>
        <field name="arch" type="xml">
            <form string="Xero Tax Mapping">
                <sheet>
                    <group>
                        <field name="xero_instance_id" readonly="1"/>
                        <field name="xero_tax_id" readonly="1"/>
                        <field name="xero_tax_name" readonly="1"/>
                        <field name="tax_id" widget="many2many_tags" readonly="1"/>
                        <field name="xero_response"  widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xero_tax_map_filter" model="ir.ui.view">
        <field name="name">xero.tax.map.search</field>
        <field name="model">xero.tax.map</field>
        <field name="arch" type="xml">
            <search string="Search Xero Tax Map">
                <field name="xero_tax_name"
                   string="Tax"
                   filter_domain="['|','|',('xero_tax_id','ilike', self),('xero_tax_name','ilike', self),('tax_id.name','ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_xero_tax_mapping" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">xero.tax.map</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
