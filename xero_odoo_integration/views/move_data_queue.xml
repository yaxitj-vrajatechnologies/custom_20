<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="xero_invoice_data_tree_view" model="ir.ui.view">
            <field name="name">Xero Move Data</field>
            <field name="model">move.data.queue</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="instance_id" required="1"/>
                    <field name="create_date"/>
                    <field name="state" decoration-success="state == 'completed'" decoration-info="state == 'draft'"
                           decoration-warning="state == 'partially_completed'" decoration-danger="state == 'failed'"
                           widget="badge"/>
                </list>
            </field>
        </record>
        <record id="xero_invoice_data_form" model="ir.ui.view">
            <field name="name">Xero Move Data</field>
            <field name="model">move.data.queue</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button class="btn-primary" type="object" name="process_xero_invoice_queue"
                                string="Process Queue Manually"
                                invisible="state == 'completed'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <div class="alert alert-info text-left" role="alert">
                        <ul>
                            <li>
                                To process the queue click on the Process Queue Manually button.
                            </li>
                            <li>
                                If a queue line failed for any reason and by making required
                                changes
                                in Odoo it can process it successfully, so you can try this option to click process
                                manually.
                            </li>
                            <li>
                                This will not fetch any data from the Xero store to reprocess it.
                            </li>
                            <li>
                                This process might take some time to complete.
                            </li>
                        </ul>
                    </div>
                    <sheet>
                        <div>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="instance_id"/>
                                <field name="create_date" string="Imported at"/>
                            </group>
                            <group>
                                <field name="xero_log_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Invoice/Bill Queue Detail Line" name="invoice_queue_detail_line">
                                <field name="move_queue_line_ids" readonly="1">
                                    <list decoration-danger="state == 'failed'"
                                          decoration-success="state == 'completed'">
                                        <field name="name"/>
                                        <field name="move_data_id" readonly="1"/>
                                        <field name="xero_move_type" readonly="1"/>
                                        <field name="state"/>

                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="move_queue_id"/>
                                                    <field name="xero_move_type"/>
                                                    <field name="instance_id" readonly="1"/>
                                                    <field name="state" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="move_data_id"/>
                                                    <field name="number_of_fails"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Response Data" name="response">
                                                    <field name="move_data_to_process" widget="ace"
                                                    />
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_xero_invoice_queue" model="ir.actions.act_window">
            <field name="name">Xero Invoice/Bill Queue</field>
            <field name="res_model">move.data.queue</field>
            <field name="view_id" ref="xero_invoice_data_tree_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Invoice Queue will display here
                </p>
            </field>
        </record>
    </data>
    <data>
        <record id="seq_xero_move_queue" model="ir.sequence">
            <field name="name">Xero move queue seq</field>
            <field name="code">move.data.queue</field>
            <field name="padding">5</field>
            <field name="prefix">Invoice/Bill/Queue/</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>