<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_refresh_xero_token" model="ir.cron">
            <field name="name">Refresh Xero Access Token</field>
            <field name="model_id" ref="xero_odoo_integration.model_xero_connect"/>
            <field name="state">code</field>
            <field name="code">model.refresh_xero_access_token()</field>
            <field name="interval_number">25</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="server_action_export_partner_to_xero" model="ir.actions.server">
            <field name="name">Export Customers &amp; Vendors to Xero</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">action = records.action_instance_wizard()</field>
        </record>

        <record id="server_action_export_invoice_and_bill_to_xero" model="ir.actions.server">
            <field name="name">Export Invoice &amp; Bill to Xero</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">action = records.action_xero_instance_for_move()</field>
        </record>

        <record id="server_action_export_product_to_xero" model="ir.actions.server">
            <field name="name">Export Product to Xero</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">action = records.action_xero_instance_for_product()</field>
        </record>

        <record id="server_action_export_payment_to_xero" model="ir.actions.server">
            <field name="name">Export Payment to Xero</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">action = records.action_xero_instance_for_payment()</field>
        </record>

        <record id="server_action_export_analytic_to_xero" model="ir.actions.server">
            <field name="name">Export Analytic Accounts to Xero</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="binding_model_id" ref="analytic.model_account_analytic_account"/>
            <field name="state">code</field>
            <field name="code">action = records.action_xero_instance_for_analytics_account()</field>
        </record>

        <record id="server_action_export_chart_of_account_to_xero" model="ir.actions.server">
            <field name="name">Export Charts Of Accounts to Xero</field>
            <field name="model_id" ref="account.model_account_account"/>
            <field name="binding_model_id" ref="account.model_account_account"/>
            <field name="state">code</field>
            <field name="code">action = records.action_xero_instance_for_accounts()</field>
        </record>

        <record id="invoice_cron_process_xero_invoice_queue" model="ir.cron">
            <field name="name">Xero: Process Invoice Queue</field>
            <field name="model_id" ref="model_move_data_queue"/>
            <field name="state">code</field>
            <field name="code">model.process_xero_invoice_queue_using_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="creditnote_cron_process_xero_invoice_queue" model="ir.cron">
            <field name="name">Xero: Process Credit Note Queue</field>
            <field name="model_id" ref="model_creditnote_data_queue"/>
            <field name="state">code</field>
            <field name="code">model.process_xero_creditnote_queue_using_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="server_action_export_consolidated_invoices_to_xero" model="ir.actions.server">
            <field name="name">Export Consolidated Invoices to Xero</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">action = records.action_xero_instance_for_move()</field>
        </record>

        <record id="seq_xero_consolidated_invoices" model="ir.sequence">
            <field name="name">Xero Consolidated Invoices</field>
            <field name="code">xero.consolidated.invoice</field>
            <field name="prefix">XI-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="execute_import_move_from_xero" model="ir.cron">
            <field name="name">Import Invoices/Bills/Credit Note/Payment from Xero</field>
            <field name="model_id" ref="xero_odoo_integration.model_xero_connect"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="state">code</field>
            <field name="code">model.auto_import_moves_payment_from_xero()</field>
        </record>

    </data>
</odoo>
