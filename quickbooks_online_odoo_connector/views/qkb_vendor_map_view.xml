<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_qkb_vendor_form" model="ir.ui.view">
        <field name="name">qbo.vendor.map.form</field>
        <field name="model">qbo.vendor.map.vts</field>
        <field name="arch" type="xml">
            <form string="Quickbooks Vendor">
                <sheet>
                    <group>
                        <field name="quickbook_instance_id" readonly="1"/>
                        <field name="qbk_vendor_id" readonly="1"/>
                        <field name="qbk_vendor_name" readonly="1"/>
                        <field name="vendor_id"/>
                        <field name="company_id"/>
                        <field name="qbo_response" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qbo_vendor_map_filter" model="ir.ui.view">
        <field name="name">qbo.vendor.map.vts.search</field>
        <field name="model">qbo.vendor.map.vts</field>
        <field name="arch" type="xml">
            <search string="Search QuickBooks Vendors">

                <!-- Same style as previous search views -->
                <field name="vendor_id"
                       string="Vendor"
                       filter_domain="['|', '|',
                           ('qbk_vendor_id', 'ilike', self),
                           ('qbk_vendor_name', 'ilike', self),
                           ('vendor_id.name', 'ilike', self)
                       ]"
                />

            </search>
        </field>
    </record>
    <record id="view_qkb_vendor_list" model="ir.ui.view">
        <field name="name">qbo.vendor.map.vts.list</field>
        <field name="model">qbo.vendor.map.vts</field>
        <field name="arch" type="xml">
            <list string="Quickbooks Vendor" editable="bottom">
                <field name="quickbook_instance_id" readonly="1"/>
                <field name="qbk_vendor_id" readonly="1"/>
                <field name="qbk_vendor_name" readonly="1"/>
                <field name="vendor_id"/>
                <button name="qkb_vendor_mapping_view" type="object" string="View" class="btn btn-link"/>
            </list>
        </field>
    </record>
    <record id="action_qbk_vendor_map" model="ir.actions.act_window">
        <field name="name">Quickbooks Vendor</field>
        <field name="res_model">qbo.vendor.map.vts</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qkb_vendor_list"/>
    </record>

    <menuitem id="menu_qbk_vendor"
              name="Vendors"
              parent="quickbooks_common_connector_vts.main_mapping_menu"
              action="action_qbk_vendor_map" sequence="2"/>
</odoo>
