<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="server_action_export_customer_and_vendor_qkca" model="ir.actions.server">
            <field name="name">Export Customers &amp; Vendors to QuickBooks Canada</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">action = records.action_qkca_instance_wizard()</field>
        </record>

        <record id="server_action_export_payment_term_qkca" model="ir.actions.server">
            <field name="name">Export Payment Term to QuickBooks Canada</field>
            <field name="model_id" ref="account.model_account_payment_term"/>
            <field name="binding_model_id" ref="account.model_account_payment_term"/>
            <field name="state">code</field>
            <field name="code">action = records.action_qkca_instance_for_payment_term()</field>
        </record>

        <record id="server_action_export_chart_of_account_qkca" model="ir.actions.server">
            <field name="name">Export Chart of Accounts to QuickBooks Canada</field>
            <field name="model_id" ref="account.model_account_account"/>
            <field name="binding_model_id" ref="account.model_account_account"/>
            <field name="state">code</field>
            <field name="code">action = records.action_qkca_instance_for_accounts()</field>
        </record>

        <record id="server_action_export_invoice_and_bill_qkca" model="ir.actions.server">
            <field name="name">Export Invoice &amp; Bill to QuickBooks Canada</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">action = records.action_qkca_instance_for_move()</field>
        </record>

        <record id="server_action_export_product_qkca" model="ir.actions.server">
            <field name="name">Export Product to QuickBooks Canada</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">action = records.action_qkca_instance_for_product()</field>
        </record>

        <record id="server_action_export_payment_qkca" model="ir.actions.server">
            <field name="name">Export Payment to QuickBooks Canada</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">action = records.action_qkca_instance_for_payment()</field>
        </record>

        <record id="execute_export_move_to_quickbook_canada" model="ir.cron">
            <field name="name">Export Invoices/Bills to Quickbooks Canada</field>
            <field name="model_id" ref="quickbooks_odoo_connector_canada.model_quickbooks_connect"/>
            <field name="interval_number">5</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="state">code</field>
            <field name="code">model.export_moves_to_qkca()</field>
        </record>

        <record id="execute_export_payment_to_quickbook_canada" model="ir.cron">
            <field name="name">Export Payment/Bill Payment to Quickbooks Canada</field>
            <field name="model_id" ref="quickbooks_odoo_connector_canada.model_quickbooks_connect"/>
            <field name="interval_number">5</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="state">code</field>
            <field name="code">model.export_payments_to_qkca()</field>
        </record>

        <record id="execute_import_move_from_quickbook_canada" model="ir.cron">
            <field name="name">Import Invoices/Bills from Quickbooks</field>
            <field name="model_id" ref="quickbooks_odoo_connector_canada.model_quickbooks_connect"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="state">code</field>
            <field name="code">model.import_moves_to_qkca()</field>
        </record>

        <record id="execute_import_payment_to_quickbook_canada" model="ir.cron">
            <field name="name">Import Payment/Bill Payment from Quickbooks</field>
            <field name="model_id" ref="quickbooks_odoo_connector_canada.model_quickbooks_connect"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active">True</field>
            <field name="state">code</field>
            <field name="code">model.import_payments_to_qkca()</field>
        </record>

        <record id="qkca_duplicate_customer_vendor_sequence" model="ir.sequence">
            <field name="name">Quickbook Canada Customer and Vendor</field>
            <field name="code">qck.res.partner</field>
            <field name="prefix">0</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
