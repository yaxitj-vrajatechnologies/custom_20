<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_qkb_product_ca_form" model="ir.ui.view">
        <field name="name">qbo.product.ca.map.form</field>
        <field name="model">qbo.product.ca.map.vts</field>
        <field name="arch" type="xml">
            <form string="Quickbooks Product">
                <sheet>
                    <group>
                        <field name="quickbook_instance_id" readonly="1"/>
                        <field name="quickbook_product_id" readonly="1"/>
                        <field name="quickbook_product_name" readonly="1"/>
                        <field name="product_id"/>
                        <field name="company_id"/>
                        <field name="qbo_response" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_qkv_product_map_filter" model="ir.ui.view">
        <field name="name">qbo.product.ca.map.vts.search</field>
        <field name="model">qbo.product.ca.map.vts</field>
        <field name="arch" type="xml">
            <search string="Search QuickBooks Product Map">
                <field name="product_id"
                       string="Product"
                       filter_domain="['|', '|',('quickbook_product_id', 'ilike', self),
                           ('quickbook_product_name', 'ilike', self),('product_id.name', 'ilike', self)]"/>
            </search>
        </field>
    </record>
    <record id="view_qkb_product_ca_list" model="ir.ui.view">
        <field name="name">qbo.product.ca.map.vts.list</field>
        <field name="model">qbo.product.ca.map.vts</field>
        <field name="arch" type="xml">
            <list string="Quickbooks Product" editable="bottom">
                <field name="quickbook_instance_id" readonly="1"/>
                <field name="quickbook_product_id" readonly="1"/>
                <field name="quickbook_product_name" readonly="1"/>
                <field name="product_id"/>
                <button name="product_mapping_view" type="object" string="View" class="btn btn-link"/>
            </list>
        </field>
    </record>
    <record id="action_qkca_product_map" model="ir.actions.act_window">
        <field name="name">Quickbooks Product</field>
        <field name="res_model">qbo.product.ca.map.vts</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_qkca_product"
              name="Products"
              parent="quickbooks_common_connector_vts.main_mapping_menu"
              action="action_qkca_product_map" sequence="1"/>
</odoo>
