<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Kanban View ────────────────────────────────────────────────── -->
    <record id="view_gmc_feed_kanban" model="ir.ui.view">
        <field name="name">gmc.feed.kanban</field>
        <field name="model">gmc.feed</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="remote_filename"/>
                <field name="last_sync"/>
                <field name="last_status"/>
                <field name="log_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_color_0" t-att-class="'oe_kanban_color_' + record.color.raw_value"/>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="o_kanban_tags_section">
                                <span t-if="record.last_status.raw_value === 'success'" class="badge text-bg-success">✔ Success</span>
                                <span t-elif="record.last_status.raw_value === 'error'" class="badge text-bg-danger">✖ Error</span>
                                <span t-else="" class="badge text-bg-secondary">—</span>
                            </div>
                            <ul class="o_kanban_record_body">
                                <li>File: <field name="remote_filename"/></li>
                                <li t-if="record.last_sync.value">Last sync: <field name="last_sync"/></li>
                                <li>Logs: <field name="log_count"/></li>
                            </ul>
                            <div class="oe_kanban_bottom_right">
                                <button name="action_upload_now" type="object" class="btn btn-sm btn-primary">Upload Now</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_gmc_feed_tree" model="ir.ui.view">
        <field name="name">gmc.feed.tree</field>
        <field name="model">gmc.feed</field>
        <field name="arch" type="xml">
            <list string="GMC Feeds" decoration-danger="last_status == 'error'" decoration-success="last_status == 'success'">
                <field name="name"/>
                <field name="remote_filename"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'paused'" decoration-info="state == 'draft'"/>
                <field name="last_sync"/>
                <field name="last_status" widget="badge" decoration-success="last_status == 'success'" decoration-danger="last_status == 'error'"/>
                <field name="log_count" string="Logs"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_gmc_feed_form" model="ir.ui.view">
        <field name="name">gmc.feed.form</field>
        <field name="model">gmc.feed</field>
        <field name="arch" type="xml">
            <form string="GMC Feed">
                <header>
                    <button name="action_upload_now" type="object" string="Upload Now" class="btn-primary" icon="upload"/>
                    <button name="action_preview_feed" type="object" string="Preview Feed" class="btn-outline-secondary" icon="visibility"/>
                    <button name="action_activate" type="object" string="Activate" invisible="state not in ('draft', 'paused')" class="btn-success"/>
                    <button name="action_pause" type="object" string="Pause" invisible="state != 'active'" class="btn-warning"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'paused'" class="btn-info"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="history">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Active" bg_color="text-bg-success" invisible="state != 'active'"/>
                    <widget name="web_ribbon" title="Paused" bg_color="text-bg-warning" invisible="state != 'paused'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Google Shopping – US (USD)"/></h1>
                    </div>
                    <group>
                        <group string="Feed Settings">
                            <field name="remote_filename"/>
                            <div colspan="2" class="text-muted" style="margin-top: -5px; margin-bottom: 15px; font-size: 0.9em;">
                                <i class="oi text-warning" data-icon="warning"/> <strong>Warning:</strong> Ensure this exactly matches the registered feed filename inside your Google Merchant Center account. If they don't match, Google will silently ignore the uploaded file!
                            </div>
                            <field name="language_id"/>
                            <field name="currency_id"/>
                            <field name="pricelist_id"/>
                        </group>
                        <group string="Store">
                            <field name="store_title"/>
                            <field name="store_url"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ── Product Filter ── -->
                        <page string="Product Filter" name="filter">
                            <group>
                                <field name="product_domain" widget="domain" options="{'model': 'product.template'}"/>
                                <field name="include_variants" widget="boolean_toggle"/>
                                <field name="max_products"/>
                            </group>
                            <separator string="Stock Settings"/>
                            <group>
                                <field name="stock_location_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True, 'no_open': True}"
                                    domain="[('usage', '=', 'internal')]"
                                    placeholder="All locations (leave empty for total stock)"
                                    colspan="2"/>
                            </group>
                            <div class="alert alert-info mt-2" role="status">
                                <i class="oi me-1" data-icon="location_on" title="Stock Location Filter"/>
                                <strong>Stock Location Filter:</strong>
                                When one or more locations are selected, the <code>g:availability</code> field will be calculated
                                as the <strong>sum of available stock</strong> across those specific locations only.
                                If left empty, the product's <strong>total stock</strong> across all locations is used.
                            </div>
                        </page>

                        <!-- ── SFTP Settings ── -->
                        <page string="SFTP Settings" name="sftp">
                            <group>
                                <field name="use_global_sftp"/>
                            </group>
                            <group invisible="use_global_sftp == True">
                                <group>
                                    <field name="sftp_host"/>
                                    <field name="sftp_port"/>
                                </group>
                                <group>
                                    <field name="sftp_username"/>
                                    <field name="sftp_password" password="True"/>
                                </group>
                            </group>
                            <group invisible="use_global_sftp == False">
                                <p class="text-muted">
                                    Using global SFTP credentials from
                                    <strong>Settings → Google Merchant Center</strong>.
                                    Server: <strong>partnerupload.google.com:19321</strong>
                                </p>
                            </group>
                            <div class="mt-3">
                                <button name="action_test_sftp_connection" type="object" string="Test SFTP Connection" class="btn-outline-success" icon="power"/>
                            </div>
                        </page>

                        <!-- ── Feed Columns ── -->
                        <page string="Feed Columns" name="columns">
                            <div class="alert alert-info mb-3" role="status">
                                <div class="float-end">
                                    <button name="action_load_default_columns" type="object" string="Load Default Columns" icon="download" class="btn-primary btn-sm"/>
                                </div>
                                <h4 class="alert-heading"><i class="oi me-1" data-icon="info" title="Information"/> <strong>Understanding Feed Columns</strong></h4>
                                <p>
                                    This table defines the precise XML structure of your exported product feed. You can easily map Odoo data directly to Google Merchant Center attributes:
                                </p>
                                <hr/>
                                <ul class="mb-0">
                                    <li class="mb-1"><strong>Model Field:</strong> Select a dynamic field directly from your products (e.g., <code>Internal Reference</code>, <code>Sales Description</code>) to be parsed for every item.</li>
                                    <li class="mb-1"><strong>Smart Rendering:</strong> Standard tags like <code>g:image_link</code>, <code>g:price</code>, or <code>g:availability</code> automatically format the Odoo models correctly into Google's required standards behind the scenes.</li>
                                    <li><strong>Static Override:</strong> Leave the Model Field blank and use <strong>Static Value</strong> to hardcode exact text universally across the entire feed (e.g., forcing <code>g:condition</code> to equal <code>new</code>).</li>
                                </ul>
                            </div>
                            <field name="column_ids" context="{'active_test': False}">
                                <list editable="bottom" optional="show">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="column_key"/>
                                    <field name="custom_column_key" invisible="column_key != 'custom'" required="column_key == 'custom'"/>
                                    <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="static_value"/>
                                    <field name="is_required"/>
                                    <field name="active" widget="toggle_button"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Attribute Mappings ── -->
                        <page string="Attribute Mappings" name="attribute_mappings" invisible="not include_variants">
                            <div class="alert alert-info mb-3" role="status">
                                <h4 class="alert-heading"><i class="oi me-1" data-icon="account_tree" title="Information"/> <strong>Variant Attribute Mappings</strong></h4>
                                <p>
                                    When variants are exported, Google requires you to identify exactly how they differ using standard tags (like <code>g:size</code>, <code>g:color</code>, etc.).
                                    By default, this module auto-detects English attributes (e.g., 'Color', 'Size', 'Material') and safely falls back to 'Size' for unknown attributes so Google doesn't reject your variants. 
                                    Use the table below to <strong>explicitly map your Odoo attributes</strong> to specific Google tags and override the built-in auto-detection for this feed.
                                </p>
                            </div>
                            <field name="attribute_mapping_ids">
                                <list editable="bottom">
                                    <field name="attribute_id" options="{'no_create': True}"/>
                                    <field name="gmc_tag"/>
                                    <field name="custom_tag" invisible="gmc_tag != 'custom'" required="gmc_tag == 'custom'"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Sync Info ── -->
                        <page string="Sync Info" name="sync">
                            <group>
                                <field name="last_sync" readonly="1"/>
                                <field name="last_status" readonly="1" widget="badge"
                                    decoration-success="last_status == 'success'"
                                    decoration-danger="last_status == 'error'"/>
                            </group>
                            <field name="log_ids" readonly="1">
                                <list string="Upload History" decoration-danger="status == 'error'" decoration-success="status == 'success'">
                                    <field name="create_date" string="Date"/>
                                    <field name="trigger"/>
                                    <field name="remote_filename"/>
                                    <field name="status" widget="badge"
                                        decoration-success="status == 'success'"
                                        decoration-danger="status == 'error'"/>
                                    <field name="product_count"/>
                                    <field name="file_size_kb"/>
                                    <field name="duration_seconds"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────── -->
    <record id="view_gmc_feed_search" model="ir.ui.view">
        <field name="name">gmc.feed.search</field>
        <field name="model">gmc.feed</field>
        <field name="arch" type="xml">
            <search string="Search Feeds">
                <field name="name"/>
                <field name="remote_filename"/>
                <filter name="active_feeds" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft_feeds" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="failed" string="Last Upload Failed" domain="[('last_status', '=', 'error')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────── -->
    <record id="action_gmc_feed" model="ir.actions.act_window">
        <field name="name">GMC Feeds</field>
        <field name="res_model">gmc.feed</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_gmc_feed_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Google Merchant Center Feed!
            </p>
            <p>
                Configure product filters, SFTP credentials, and feed columns,
                then click <strong>Upload Now</strong> to submit to Google.
            </p>
        </field>
    </record>

</odoo>
