<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled cron: run every 6 hours for all active feeds -->
        <record id="ir_cron_gmc_feed_upload" model="ir.cron">
            <field name="name">Google Merchant Center — Auto Feed Upload</field>
            <field name="model_id" ref="model_gmc_feed"/>
            <field name="state">code</field>
            <field name="code">model.run_scheduled_feed_upload()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
