<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="shipping_label_vts_form_view" model="ir.ui.view">
            <field name="name">shipping.label.vts.form.view</field>
            <field name="model">shipping.label.vts</field>
            <field name="arch" type="xml">
                <form string="Shipping Label Form" create="false" edit="false">
                    <sheet>
                        <group>
                            <field name="create_date" widget="datetime"/>
                            <field name="printnode_instance_id"/>
                            <field name="printjob_id" readonly="1"/>
                            <field name="carrier_id" ref="delivery_carrier"/>
                            <field name="picking_id"/>
                            <field name="tracking_number" width="10"/>
                            <field name="shipping_label_ids"/>
                            <!--                            <field name="return_label_ids"/>-->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="shipping_label_vts_list_view" model="ir.ui.view">
            <field name="name">shipping.label.vts.list.view</field>
            <field name="model">shipping.label.vts</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Shipping Label" create="false" edit="false">
                    <field name="create_date" widget="datetime"/>
                    <field name="printnode_instance_id"/>
                    <field name="printjob_id" readonly="1" width="150"/>
                    <field name="carrier_id" ref="delivery_carrier" width="120"/>
                    <field name="picking_id"/>
                    <field name="tracking_number" readonly="1" width="120"/>
                    <field name="shipping_label_ids"/>
                    <field name="return_label_ids"/>
                    <button name="print_through_printnode" type="object" icon="print" string="Print Label"
                            aria-label="Send to Printer" title="Send shipping labels to Printer via PrintNode"/>
                </list>
            </field>
        </record>
        <record id="action_shipping_label_vts_menu" model="ir.actions.act_window">
            <field name="name">Shipping Labels</field>
            <field name="res_model">shipping.label.vts</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="shipping_label_vts_list_view"/>
        </record>

        <menuitem id="printnode_shipping_label_menu"
                  name="Shipping Labels"
                  parent="printnode_odoo_connector.printnode_printjob_menu"
                  sequence="10"
                  action="action_shipping_label_vts_menu"/>

    </data>
</odoo>
