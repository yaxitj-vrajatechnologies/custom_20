<odoo>
    <data>
        <record id="delete_printnode_printjobs_record" model="ir.cron">
            <field name="name">Delete PrintNode PrintJob</field>
            <field name="model_id" ref="printnode_odoo_connector.model_printnode_printjob_vts"/>
            <field name="state">code</field>
             <field name="code">model.unlink_printjobs_request()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="sync_printnode_data_record_vts" model="ir.cron">
            <field name="name">Sync PrintNode Data</field>
            <field name="model_id" ref="printnode_odoo_connector.model_printnode_connect"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all_printnode_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
