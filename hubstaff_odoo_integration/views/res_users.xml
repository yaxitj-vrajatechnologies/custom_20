<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_users_form_inherited" model="ir.ui.view">
        <field name="name">view.res.users.form.inherited</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page name="hubstaff_configuration" string="Hubstaff Configuration">
                    <group>
                        <field name="hubstaff_user_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_sync_hubstaff_user"
                        type="object"
                        string="Sync Hubstaff User"
                        class="btn-primary"
                />
            </xpath>
        </field>
    </record>
</odoo>