<odoo>

    <!-- Tree/List View -->
    <record id="hubstaff_log_list" model="ir.ui.view">
        <field name="name">hubstaff.log.list</field>
        <field name="model">hubstaff.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="company_id"/>
                <field name="instance_id"/>
                <field name="process_name"/>
                <field name="process_type"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hubstaff_log_form" model="ir.ui.view">
        <field name="name">hubstaff.log.form</field>
        <field name="model">hubstaff.log</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="instance_id" readonly="1"/>
                        <field name="process_name" readonly="1"/>
                        <field name="process_type" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Log Details">
                            <field name="log_line_ids" readonly="1">
                                <list>
<!--                                    <field name="name" readonly="1"/>-->
<!--                                    <field name="process_type" readonly="1"/>-->
<!--                                    <field name="process_name" readonly="1"/>-->
                                    <field name="message" readonly="1"/>
                                    <field name="create_date"/>

                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="hubstaff_log_search" model="ir.ui.view">
        <field name="name">hubstaff.log.search</field>
        <field name="model">hubstaff.log</field>
        <field name="arch" type="xml">
            <search string="Hubstaff Logs">
                <field name="name"/>
                <field name="company_id"/>
                <field name="instance_id"/>
                <field name="process_type"/>
                <field name="create_date"/>
                <filter string="Company"
                        name="group_company"
                        context="{'group_by': 'company_id'}"/>

                <filter string="Instance"
                        name="group_instance"
                        context="{'group_by': 'instance_id'}"/>

                <filter string="Process Type"
                        name="group_process"
                        context="{'group_by': 'process_type'}"/>

            </search>
        </field>
    </record>

    <!-- Tree (List) View -->
    <record id="hubstaff_log_line_list" model="ir.ui.view">
        <field name="name">hubstaff.log.line.list</field>
        <field name="model">hubstaff.log.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
<!--                <field name="name"/>-->
                <field name="log_id"/>
<!--                <field name="process_type"/>-->
                <field name="create_date"/>
                <field name="company_id"/>
<!--                <field name="api_request"/>-->
<!--                <field name="api_response"/>-->
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hubstaff_log_line_form" model="ir.ui.view">
        <field name="name">hubstaff.log.line.form</field>
        <field name="model">hubstaff.log.line</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
<!--                        <field name="name" readonly="1"/>-->
                        <field name="log_id" readonly="1"/>
<!--                        <field name="process_type" readonly="1"/>-->
                        <field name="create_date"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="API Request">
                            <field name="api_request" readonly="1" widget="text"/>
                        </page>

                        <page string="API Response">
                            <field name="api_response" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>


    <!-- Window Action for Logs -->
    <record id="hubstaff_log_action" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">hubstaff.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create or view Hubstaff instance logs here.
            </p>
        </field>
    </record>

    <record id="hubstaff_log_line_action" model="ir.actions.act_window">
        <field name="name">Log Lines</field>
        <field name="res_model">hubstaff.log.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
