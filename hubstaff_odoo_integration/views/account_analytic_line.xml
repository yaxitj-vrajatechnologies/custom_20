<odoo>
    <record id="view_account_analytic_line_hubstaff" model="ir.ui.view">
        <field name="name">account.analytic.line.form.hubstaff</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="is_billable" readonly="1" optional="hide"/>
                <field name="hubstaff_task_entry_id" readonly="1" optional="hide"/>
                <field name="hubstaff_task_id" readonly="1" optional="hide"/>
                <field name="hubstaff_instance_id" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>