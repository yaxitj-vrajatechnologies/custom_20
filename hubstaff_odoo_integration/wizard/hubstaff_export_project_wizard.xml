<odoo>
    <record id="view_hubstaff_export_project_wizard_form" model="ir.ui.view">
        <field name="name">hubstaff.export.project.wizard.form</field>
        <field name="model">hubstaff.export.project.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Projects to Hubstaff">
                <sheet>
                    <group>
                        <field name="instance_id"/>

                    </group>
                </sheet>
                <footer>
                    <button name="action_export_projects" type="object" string="Export" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>